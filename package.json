{
  "name": "pi-image-slim",
  "type": "module",
  "version": "0.1.0",
  "description": "Pi extension that stops historical images from being re-uploaded on every request — each image is sent in full exactly once, then replaced by a path-carrying placeholder.",
  "author": "wiidede",
  "license": "MIT",
  "homepage": "https://github.com/wiidede/pi-image-slim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiidede/pi-image-slim.git"
  },
  "bugs": {
    "url": "https://github.com/wiidede/pi-image-slim/issues"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "pi-coding-agent",
    "coding-agent",
    "image",
    "images",
    "context",
    "bandwidth",
    "upload",
    "tokens",
    "screenshot"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": "./index.ts"
  },
  "main": "./index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "index.ts"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "release": "pnpm check && bumpp",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
